function updateNow(){const ms=Date.now(),p=currentPlan(ms);const clock=zone=>new Intl.DateTimeFormat('ja-JP',{timeZone:zone,month:'numeric',day:'numeric',weekday:'short',hour:'2-digit',minute:'2-digit',hour12:false}).format(new Date(ms));document.getElementById('jpclock').textContent=clock('Asia/Tokyo');document.getElementById('usclock').textContent=clock('America/New_York');document.getElementById('now-title').textContent=p.title;document.getElementById('now-place').textContent=p.place;document.getElementById('now-next').textContent=p.next?p.next.text:'予定されていた行程はすべて終了です。';document.getElementById('next-label').textContent='次の時刻付き予定';document.getElementById('now-jump').href='#day'+(p.day??0);document.getElementById('now-jump').textContent=p.day===null?'全日程を見る':'該当日の予定へ';if(p.day===null)document.getElementById('now-jump').href='#schedule';document.getElementById('now-terminal').href=links.out;document.getElementById('now-terminal').hidden=ms>=t.depart;document.getElementById('now-checkin').hidden=!p.checkin;document.querySelectorAll('.day').forEach((el,i)=>el.classList.toggle('is-today',i===p.day));document.querySelectorAll('[data-daylink]').forEach(el=>el.classList.toggle('current',Number(el.dataset.daylink)===p.day));document.querySelectorAll('.event[id]').forEach(el=>el.classList.toggle('is-now',el.id===p.event));}
